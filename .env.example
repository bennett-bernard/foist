# Slack tokens from your app settings. Socket Mode requires both.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me

# Set this once to: openai, anthropic, grok, gemini, or openai-compatible.
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.6-terra

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-replace-me
# ANTHROPIC_MODEL=your-claude-model

# Grok (xAI)
# GROK_API_KEY=xai-replace-me
# GROK_MODEL=your-grok-model
# GROK_REASONING_EFFORT=low

# Gemini (Google)
# GEMINI_API_KEY=replace-me
# GEMINI_MODEL=your-gemini-model

# Internal scores at or above this value receive "YOU GOT FOISTED" and a draft offer.
FOIST_FOISTED_THRESHOLD=65

# Pending "Foist back" requests expire after this many minutes.
FOIST_PENDING_TTL_MINUTES=60
FOIST_DATA_PATH=.data/pending.json

# Secret mixed into privacy-preserving provider safety identifiers.
FOIST_SAFETY_SALT=replace-with-long-random-text
