# Slack tokens from your app settings. Socket Mode requires both.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me

# OpenAI API key.
OPENAI_API_KEY=sk-replace-me

# Assessment routing: Terra handles every first pass; Sol reviews uncertain cases.
OPENAI_PRIMARY_MODEL=gpt-5.6-terra
OPENAI_ADJUDICATOR_MODEL=gpt-5.6-sol
OPENAI_DRAFT_MODEL=gpt-5.6-terra
FOIST_PRIMARY_REASONING=medium
FOIST_ADJUDICATOR_REASONING=medium
FOIST_ADJUDICATION_ENABLED=true
FOIST_ADJUDICATION_MIN_PERCENT=30
FOIST_ADJUDICATION_MAX_PERCENT=85

# Internal scores at or above this value receive "YOU GOT FOISTED" and a draft offer.
FOIST_FOISTED_THRESHOLD=65

# Pending "Foist back" requests expire after this many minutes.
FOIST_PENDING_TTL_MINUTES=60
FOIST_DATA_PATH=.data/pending.json

# Optional secret mixed into privacy-preserving API safety identifiers.
FOIST_SAFETY_SALT=replace-with-random-text
