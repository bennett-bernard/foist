{
  "name": "foist-slack-bot",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "description": "A playful Slack bot that estimates AI writing signals and drafts gloriously AI-sounding replies.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "dev:self-hosted": "tsx watch src/self-hosted.ts",
    "eval": "tsx scripts/evaluate.ts",
    "start": "node dist/src/self-hosted.js",
    "start:self-hosted": "node dist/src/self-hosted.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@google/genai": "^2.19.0",
    "@slack/bolt": "^5.0.0",
    "@slack/logger": "^5.0.0",
    "@slack/types": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "dotenv": "^17.4.2",
    "openai": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
