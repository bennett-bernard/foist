# Single-workspace HTTP development credentials.
# OAuth and a database-backed installation store are required before public hosting.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me
PORT=3000

# Set this once to: openai, anthropic, grok, gemini, or openai-compatible.
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.6-terra

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-replace-me
# ANTHROPIC_MODEL=your-claude-model

# Grok (xAI)
# GROK_API_KEY=xai-replace-me
# GROK_MODEL=your-grok-model
# GROK_REASONING_EFFORT=low

# Gemini (Google)
# GEMINI_API_KEY=replace-me
# GEMINI_MODEL=your-gemini-model

# OpenAI Responses-compatible provider
# COMPATIBLE_API_KEY=replace-me
# COMPATIBLE_MODEL=your-model
# COMPATIBLE_BASE_URL=https://your-provider.example/v1

FOIST_FOISTED_THRESHOLD=65
FOIST_PENDING_TTL_MINUTES=60
FOIST_DATA_PATH=.data/pending.json
FOIST_SAFETY_SALT=replace-with-long-random-text
