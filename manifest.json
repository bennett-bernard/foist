{
  "display_information": {
    "name": "Foist",
    "description": "Playfully inspect Slack messages for AI-writing signals.",
    "background_color": "#5B3FF5"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Foist",
      "always_online": false
    },
    "shortcuts": [
      {
        "name": "Foist this message",
        "type": "message",
        "callback_id": "foist_message",
        "description": "Inspect this message for AI-writing signals"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "im:history",
        "im:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
